# Copy this file to .env and fill in your own values. Never commit .env.

# MQTT broker (EMQX Cloud)
MQTT_HOST=your-deployment.emqxsl.com
MQTT_PORT=8883
MQTT_USER=
MQTT_PASS=

# LLM
GEMINI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Home location for AFAD search (approximate)
HOME_LAT=38.49
HOME_LON=27.70
AFAD_RADIUS_KM=200
